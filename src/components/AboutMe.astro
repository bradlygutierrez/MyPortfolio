---
import "../pages/styles/aboutMe.css";
---

<main>
    <section class="about-me" id="about-me">
        <div class="image-container">
            <img
                src="profile-photo.jpg"
                alt="Profile Picture"
                class="profile-photo"
            />
            <div
                class="social-links"
                style="margin-top:1rem; display:flex; gap:1.5rem; align-items:center;"
            >
                <a
                    href="https://www.instagram.com/bradly_gutierrez_c/"
                    target="_blank"
                    title="Instagram"
                >
                    <img
                        src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/instagram.svg"
                        alt="Instagram"
                        style="width:32px;height:32px;fill:#E4405F;"
                    />
                </a>
                <a
                    href="https://www.linkedin.com/in/bradly-gutiérrez"
                    target="_blank"
                    title="LinkedIn"
                >
                    <img
                        src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg"
                        alt="LinkedIn"
                        style="width:32px;height:32px;"
                    />
                </a>
                <a
                    href="https://github.com/bradlygutierrez"
                    target="_blank"
                    title="GitHub"
                >
                    <img
                        src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg"
                        alt="GitHub"
                        style="width:32px;height:32px;"
                    />
                </a>
                <a
                    href="mailto:bradlygc@gmail.com"
                    target="_blank"
                    title="Gmail"
                    style="display:flex;align-items:center;gap:0.5rem;"
                >
                    <img
                        src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg"
                        alt="Gmail"
                        style="width:32px;height:32px;"
                    />
                    <span style="font-size:1rem;color:#62666c;"
                        >bradlygc@gmail.com</span
                    >
                </a>
            </div>
        </div>
        <div class="text-container">
            <p class="header-about-me" id="demo"></p>

            <p class="description-about-me">
                With a computer science background and a passion for design, I
                craft digital experiences that are both smart and stunning.
                Always curious, always up for a challenge—let’s connect!
            </p>
        </div>
    </section>
</main>

<script src="../scripts/animation.js"></script>
