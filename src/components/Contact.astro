---
import "../pages/styles/contact.css";
---

<footer>
    <section id="contact" class="contact-section">
        <h2 class="contact-me-title">
            Have a project on your mind?
        </h2>
        <h2 class="contact-me-title-blue">
            Contact me!
        </h2>

        <form action="https://formspree.io/f/xzzjvjen" method="POST" class="contact-form">
            <label for="name">Name:</label>
            <input class = "input-small"type="text" id="name" name="name" required />

            <label for="email">Email:</label>
            <input class = "input-small"type="email" id="email" name="_replyto" required />

            <label for="message">Message:</label>
            <textarea id="message" name="message" class="input-large"></textarea>

            <button class="sent-button" type="submit">Send</button>
        </form>
    </section>
</footer>
